{
  "name": "Gmail Reply → CONNECT Stage",
  "version": 2,
  "flow": [
    {
      "id": 1,
      "module": "google-email:TriggerNewEmail",
      "version": 2,
      "parameters": {
        "label": "Watch Emails",
        "folder": "INBOX",
        "maxResults": 10,
        "pollInterval": 300
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 }
      },
      "filter": {
        "name": "Is Reply from Others",
        "conditions": [
          [
            {
              "a": "{{1.headers.In-Reply-To}}",
              "o": "exist"
            },
            {
              "a": "{{1.from}}",
              "b": "{{env.MY_EMAIL}}",
              "o": "text:notcontain"
            }
          ]
        ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "senderEmail": "{{1.from}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "note": "Extract sender email"
      }
    },
    {
      "id": 3,
      "module": "airtable:SearchRecords",
      "version": 3,
      "parameters": {
        "base": "{{env.AIRTABLE_BASE_ID}}",
        "table": "Contacts",
        "formula": "AND({Email} = '{{2.senderEmail}}', {Stage} = 'OUTREACH')"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 5,
              "module": "airtable:ActionUpdateRecord",
              "version": 3,
              "parameters": {
                "base": "{{env.AIRTABLE_BASE_ID}}",
                "table": "Contacts",
                "id": "{{3.id}}"
              },
              "mapper": {
                "Stage": "CONNECT",
                "Last Interaction": "{{formatDate(now; \"YYYY-MM-DD\")}}"
              },
              "metadata": {
                "designer": { "x": 1200, "y": -100 },
                "note": "Advance OUTREACH → CONNECT"
              }
            },
            {
              "id": 6,
              "module": "google-email:ActionAddLabel",
              "version": 2,
              "parameters": {
                "emailId": "{{1.id}}",
                "label": "CRM: Processed"
              },
              "mapper": {},
              "metadata": {
                "designer": { "x": 1500, "y": -100 }
              }
            }
          ],
          "filter": {
            "name": "OUTREACH Contact Found",
            "conditions": [
              [{ "a": "{{3.id}}", "o": "exist" }]
            ]
          }
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false
    },
    "designer": { "orphans": [] }
  }
}
