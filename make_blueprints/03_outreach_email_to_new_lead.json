{
  "name": "03 — Sent Outreach Email → OUTREACH Stage",
  "flow": [
    {
      "id": 1,
      "module": "gmail:TriggerNewEmail",
      "version": 1,
      "parameters": {
        "account": "{{connection.gmail}}",
        "folder": "SENT",
        "criteria": "in:sent",
        "markAsRead": false,
        "maxResults": 10
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {},
        "notes": "Watches Sent folder for newly sent emails."
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.to}}"
      },
      "metadata": {
        "designer": { "x": 200, "y": 0 },
        "restore": {},
        "notes": "Iterate over all recipients of the sent email."
      }
    },
    {
      "id": 3,
      "module": "airtable:ActionSearchRecords",
      "version": 1,
      "parameters": {
        "account": "{{connection.airtable}}",
        "base": "{{env.AIRTABLE_BASE_ID}}",
        "table": "Contacts",
        "filterByFormula": "AND(LOWER({Email}) = LOWER('{{2.address}}'), {Stage} = 'NEW')",
        "maxRecords": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 400, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "builtin:Router",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      },
      "routes": [
        {
          "label": "NEW contact found — advance to OUTREACH",
          "filter": {
            "name": "Contact found in NEW stage",
            "conditions": [
              [{ "a": "{{3.total}}", "b": "0", "o": "number:greater" }]
            ]
          },
          "flow": [
            {
              "id": 5,
              "module": "airtable:ActionUpdateRecord",
              "version": 1,
              "parameters": {
                "account": "{{connection.airtable}}",
                "base": "{{env.AIRTABLE_BASE_ID}}",
                "table": "Contacts",
                "id": "{{3.records[].id}}"
              },
              "mapper": {
                "Stage": "OUTREACH",
                "Last Interaction": "{{formatDate(now; 'YYYY-MM-DD')}}"
              },
              "metadata": { "designer": { "x": 800, "y": -80 } }
            },
            {
              "id": 6,
              "module": "airtable:ActionUpdateRecord",
              "version": 1,
              "parameters": {
                "account": "{{connection.airtable}}",
                "base": "{{env.AIRTABLE_BASE_ID}}",
                "table": "Contacts",
                "id": "{{3.records[].id}}"
              },
              "mapper": {
                "Comments": "{{ifempty(3.records[].fields.Comments; '')}}---\nSent: {{1.subject}}\nDate: {{formatDate(now; 'YYYY-MM-DD HH:mm')}}"
              },
              "metadata": {
                "designer": { "x": 1000, "y": -80 },
                "notes": "Append sent email subject + date to Comments field."
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com"
  }
}
